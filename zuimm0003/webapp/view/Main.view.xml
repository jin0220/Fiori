<mvc:View
    controllerName="zuimm0003.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page
        id="page"
        title="{i18n>title}"
        class="zuimmNotificationPage">
        <content>
            <VBox class="zuimmNotificationShell">
                <IconTabBar
                    id="alertTabBar"
                    expandable="false"
                    selectedKey="{view>/selectedKey}"
                    select=".onSelectAlertTab">
                    <items>
                        <IconTabFilter
                            key="ALL"
                            text="전체 알림"
                            icon="sap-icon://notification-2"
                            count="{view>/counts/all}" />
                        <IconTabFilter
                            key="PR"
                            text="PR 결재 지연"
                            icon="sap-icon://pending"
                            iconColor="Negative"
                            count="{view>/counts/pr}" />
                        <IconTabFilter
                            key="STOCK"
                            text="재고 부족"
                            icon="sap-icon://alert"
                            iconColor="Critical"
                            count="{view>/counts/stock}" />
                        <IconTabFilter
                            key="PO"
                            text="PO 납품 지연"
                            icon="sap-icon://shipping-status"
                            iconColor="Neutral"
                            count="{view>/counts/po}" />
                    </items>
                </IconTabBar>

                <List
                    id="alertFeedList"
                    class="zuimmAlertList"
                    growing="true"
                    growingThreshold="20"
                    growingScrollToLoad="true"
                    noDataText="처리할 구매 알림이 없습니다."
                    showSeparators="Inner"
                    updateFinished=".onAlertListUpdateFinished"
                    items="{
                        path: '/AlertSet',
                        filters: [
                            {
                                path: 'ZaStatus',
                                operator: 'EQ',
                                value1: 'N'
                            }
                        ],
                        sorter: {
                            path: 'Erdat',
                            descending: true
                        }
                    }">
                    <CustomListItem type="Inactive">
                        <VBox class="zuimmFeedItem">
                            <FeedListItem
                                sender="{path: 'AlertType', formatter: '.formatCategoryText'}"
                                icon="{path: 'AlertType', formatter: '.formatCategoryIcon'}"
                                text="{Message}"
                                timestamp="{parts: [{path: 'Erdat'}, {path: 'Erzet'}], formatter: '.formatTimestamp'}"
                                info="{parts: [{path: 'RefDoc'}, {path: 'AlertId'}], formatter: '.formatInfo'}" />

                            <HBox
                                class="zuimmQuickActions"
                                justifyContent="End"
                                alignItems="Center"
                                wrap="Wrap">
                                <ObjectStatus
                                    class="zuimmAlertState"
                                    text="{path: 'AlertType', formatter: '.formatStateText'}"
                                    state="{path: 'AlertType', formatter: '.formatObjectState'}" />
                                <ToolbarSpacer />
                                <Button
                                    text="결재 독촉"
                                    icon="sap-icon://email"
                                    type="Emphasized"
                                    visible="{path: 'AlertType', formatter: '.isPRAlert'}"
                                    press=".onPressRemind" />
                                <!-- <Button
                                    text="즉시 PR 생성"
                                    icon="sap-icon://create-form"
                                    type="Accept"
                                    visible="{path: 'AlertType', formatter: '.isStockAlert'}"
                                    press=".onPressCreatePR" /> -->
                                <Button
                                    text="업체 연락처 보기"
                                    icon="sap-icon://customer"
                                    type="Default"
                                    visible="{path: 'AlertType', formatter: '.isPOAlert'}"
                                    press=".onPressViewContact" />
                            </HBox>
                        </VBox>
                    </CustomListItem>
                </List>
            </VBox>
        </content>
    </Page>
</mvc:View>
