<mvc:View controllerName="zuimm0001.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:micro="sap.suite.ui.microchart"
    xmlns="sap.m">
    
    <f:DynamicPage id="page" headerExpanded="true">
        
        <f:title>
            <f:DynamicPageTitle id="pageTitle">
                <f:heading>
                    <Title id="mainTitle" text="실시간 재고 현황 대시보드"/>
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        
        <f:header>
            <f:DynamicPageHeader id="pageHeader">
                <fb:FilterBar id="stockFilterBar" search="onSearch" showFilterConfiguration="false">
                    <fb:filterGroupItems>
                        <fb:FilterGroupItem id="filterGroupPlant" groupName="G1" name="Plant" label="플랜트">
                            <fb:control>
                                <ComboBox id="idPlant"/>
                            </fb:control>
                        </fb:FilterGroupItem>
                    </fb:filterGroupItems>
                </fb:FilterBar>
            </f:DynamicPageHeader>
        </f:header>

        <!-- RadialMicroChart를 활용한 셀 내 시각화 -->
        <f:content>
            <Table id="idStockTable" items="{/MStockSet}">
                <columns>
                <!-- 자재번호, 자재명, 플랜트, 창고, 저장위치, 가용재고, 입고예정 수량(PO), 안전재고, 스토리지빈 저장 수량(실 재고량 계산) -->
                    <Column id="colMatnr"><Text id="txtColMatnr" text="자재코드"/></Column>
                    <Column id="colMaktx"><Text id="txtColMaktx" text="자재명"/></Column>
                    <Column id="colWerks"><Text id="txtColWerks" text="플랜트"/></Column>
                    <Column id="colLgort"><Text id="txtColLgort" text="창고"/></Column>
                    <Column id="colLgpla"><Text id="txtColLgpla" text="저장위치"/></Column>
                    <Column id="colLabst"><Text id="txtColLabst" text="가용재고"/></Column>
                    <!-- <Column id="colPRCnt"><Text id="txtColPRCnt" text="PR수량"/></Column> -->
                    <Column id="colPOCnt"><Text id="txtColPOCnt" text="입고예정 수량"/></Column>
                    <Column id="colEisbe"><Text id="txtColEisbe" text="안전재고"/></Column>
                    <Column id="colLack"><Text id="txtColLack" text="실 재고량"/></Column>
                    <Column id="colTotal"><Text id="txtColTotal" text="확보 재고량"/></Column>
                </columns>
                
                <items>
                    <ColumnListItem id="idRowItem" highlight="{= ${Labst} &lt; ${Eisbe} ? 'Error' : 'None' }">
                        <cells>
                            <Text id="idTextMatnr" text="{Matnr}"/>
                            <Text id="idTextMaktx" text="{Maktx}"/>
                            <Text id="idTextWerks" text="{Werks}"/>
                            <Text id="idTextLgort" text="{Lgort}"/>
                            <Text id="idTextLgpla" text="{Lgpla}"/>
                            <Text id="idTextLabst" text="{Labst}"/>
                            <!-- <Text id="idTextPRCnt" text="{Prcnt}"/> -->
                            <Text id="idTextPOCnt" text="{Pocnt}"/>
                            <Text id="idTextEisbe" text="{Eisbe}"/>
                            
                            <VBox id="idVBoxChart">
                                <!-- <Title id="idTitleTarget" text="{TargetStock} L" titleStyle="H6"/> -->
                                <!-- <micro:RadialMicroChart 
                                    id="idRadialChart"
                                    size="XS" 
                                    percentage="{Percent}" 
                                    valueColor="{= ${Percent} &lt; 50 ? 'Error' : 'Good' }" /> -->
                                    <micro:RadialMicroChart id="idRadialChart" size="M" percentage="45" press=".press" />
                            </VBox>

                            <VBox id="idVBoxChart02">
                                <!-- <Title id="idTitleTarget" text="{TargetStock} L" titleStyle="H6"/> -->
                                <!-- <micro:RadialMicroChart 
                                    id="idRadialChart"
                                    size="XS" 
                                    percentage="{Percent}" 
                                    valueColor="{= ${Percent} &lt; 50 ? 'Error' : 'Good' }" /> -->
                                    <micro:RadialMicroChart id="idRadialChart02" size="M" percentage="45" press=".press" />
                            </VBox>
                            
                            <!-- <ObjectNumber 
                                id="idObjNumTotal"
                                number="{TotalStock}" 
                                unit="L" 
                                state="{= ${TotalStock} &lt; 5000 ? 'Error' : 'Success' }"/> -->
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </f:content>
        
    </f:DynamicPage>
</mvc:View>