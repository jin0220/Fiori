<c:FragmentDefinition
    xmlns="sap.m"
    xmlns:c="sap.ui.core">
    <TableSelectDialog
        id="idWerksHelpDialog"
        title="플랜트 선택"
        noDataText="조회된 플랜트가 없습니다"
        search=".onSearchWerks"
        confirm=".onConfirmWerks"
        cancel=".onCloseHelp"
        items="{/WerksSet}"> 
        
        <columns>
            <Column><header><Label text="플랜트번호" /></header></Column>
            <Column><header><Label text="플랜트명" /></header></Column>
        </columns>

        <ColumnListItem vAlign="Middle">
            <cells>
                <Text text="{WerksId}" />
                <Text text="{Name1}" />
            </cells>
        </ColumnListItem>
        
    </TableSelectDialog>
</c:FragmentDefinition>