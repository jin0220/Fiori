<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <TableSelectDialog
        id="idLgortHelpDialog"
        title="창고 선택"
        noDataText="조회된 창고가 없습니다"
        search=".onSearchLgort"
        confirm=".onConfirmLgort"
        cancel=".onCloseHelp"
        items="{LgortSet>/}"> 
        
        <columns>
            <Column><header><Label text="플랜트번호" /></header></Column>
            <Column><header><Label text="창고번호" /></header></Column>
            <Column><header><Label text="창고명(주소)" /></header></Column>
        </columns>

        <ColumnListItem vAlign="Middle">
            <cells>
                <Text text="{LgortSet>Werks}" />
                <Text text="{LgortSet>LgortId}" />
                <Text text="{LgortSet>Adrnr}" />
            </cells>
        </ColumnListItem>
        
    </TableSelectDialog>
</core:FragmentDefinition>