<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    
    <TableSelectDialog
        id="idMatnrHelpDialog"
        title="자재 검색"
        noDataText="조회된 자재가 없습니다"
        search=".onSearchMatnrPopup"
        confirm=".onConfirmMatnr" 
        cancel=".onCloseHelp"
        rememberSelections="false"
        items="{MaterialHelp>/}"> 
        
        <columns>
            <Column><header><Label text="자재코드" /></header></Column>
            <Column><header><Label text="자재명" /></header></Column>
        </columns>

        <ColumnListItem vAlign="Middle" type="Active"> <cells>
                <Text text="{MaterialHelp>Matnr}" />
                <Text text="{MaterialHelp>Maktx}" />
            </cells>
        </ColumnListItem>
        
    </TableSelectDialog>
</core:FragmentDefinition>